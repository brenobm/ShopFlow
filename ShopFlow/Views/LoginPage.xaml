<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             xmlns:strings="clr-namespace:BrenoMachado.ShopFlow.Resources.Strings"
             x:Class="BrenoMachado.ShopFlow.Views.LoginPage"
             Title="{x:Static strings:AppResources.LoginTitle}">


    <StackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        
        <Image Source="dotnet_bot.png" HeightRequest="100" Margin="0,0,0,20"/>
        
        <Entry Placeholder="{x:Static strings:AppResources.Username}" Text="{Binding Username}" IsVisible="{Binding IsVerification, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"/>
        
        <Entry Placeholder="{x:Static strings:AppResources.Email}" Text="{Binding Email}" IsVisible="{Binding IsSignUp}" Keyboard="Email"/>
        
        <Entry Placeholder="{x:Static strings:AppResources.Password}" Text="{Binding Password}" IsPassword="True" IsVisible="{Binding IsVerification, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"/>

        <!-- Verification Code -->
        <Entry Placeholder="{x:Static strings:AppResources.Placeholder_VerificationCode}" Text="{Binding VerificationCode}" IsVisible="{Binding IsVerification}" Keyboard="Numeric"/>

        <Button Text="{x:Static strings:AppResources.LoginButton}" 
                Command="{Binding LoginCommand}" 
                IsVisible="{Binding IsLogin}"
                BackgroundColor="#2563EB" 
                TextColor="White"/>

        <Button Text="{x:Static strings:AppResources.SignUpButton}" 
                Command="{Binding SignUpCommand}" 
                IsVisible="{Binding IsSignUp}"
                BackgroundColor="#10B981" 
                TextColor="White"/>

        <Button Text="{x:Static strings:AppResources.Btn_Verify}" 
                Command="{Binding VerifyCommand}" 
                IsVisible="{Binding IsVerification}"
                BackgroundColor="#F59E0B" 
                TextColor="White"/>

        <Button Text="{Binding IsSignUp, StringFormat='{x:Static strings:AppResources.Text_AlreadyHaveAccount}'}" 
                Command="{Binding ToggleModeCommand}"
                BackgroundColor="Transparent"
                TextColor="#2563EB"
                IsVisible="{Binding IsSignUp}"/>

        <Button Text="{Binding IsLogin, StringFormat='{x:Static strings:AppResources.Text_NeedAccount}'}" 
                Command="{Binding ToggleModeCommand}"
                BackgroundColor="Transparent"
                TextColor="#2563EB"
                IsVisible="{Binding IsLogin}"/>
                
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#2563EB"/>

    </StackLayout>
</ContentPage>
