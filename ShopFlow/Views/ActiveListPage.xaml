<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             xmlns:strings="clr-namespace:BrenoMachado.ShopFlow.Resources.Strings"
             xmlns:converters="clr-namespace:BrenoMachado.ShopFlow.Converters"
             x:Class="BrenoMachado.ShopFlow.Views.ActiveListPage"
             x:Name="ThisPage"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}"
             BackgroundColor="#F3F4F6">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CategoryToColorConverter x:Key="CategoryToColor" />
            <converters:CategoryToIconConverter x:Key="CategoryToIcon" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">
        
        <!-- Row 0: Custom Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,10" BackgroundColor="{Binding CurrentList.Color}">
             <ImageButton Grid.Column="0"
                          Source="back_arrow_white.png"
                          Command="{Binding BackCommand}"
                          BackgroundColor="Transparent"
                          VerticalOptions="Center" 
                          HeightRequest="30" WidthRequest="30">
                 <ImageButton.Source>
                     <FontImageSource Glyph="‹" Color="White" Size="40" />
                 </ImageButton.Source>
             </ImageButton>
            
            <Label Grid.Column="1"
                   Text="{Binding Title}"
                   TextColor="White"
                   FontSize="24"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Margin="10,0" />
            
            <Label Grid.Column="2"
                   Text="+"
                   FontSize="40"
                   TextColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="End">
                 <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddItemCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Row 1: Suggestions -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Suggestions}"
                        HeightRequest="50"
                        Margin="10,15,10,5"
                        SelectionMode="None"
                        IsVisible="{Binding IsShoppingMode, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12,6" BackgroundColor="White" CornerRadius="20" BorderColor="#E5E7EB" HasShadow="False">
                        <Label Text="{Binding .}" TextColor="#4B5563" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.AddSuggestionCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Triggers>
                <DataTrigger TargetType="CollectionView" Binding="{Binding Suggestions.Count}" Value="0">
                    <Setter Property="IsVisible" Value="False"/>
                    <Setter Property="HeightRequest" Value="0"/>
                </DataTrigger>
            </CollectionView.Triggers>
        </CollectionView>

        <!-- Row 2: Main List -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        IsGrouped="True"
                        Margin="20,0,20,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </CollectionView.ItemsLayout>
            
            <!-- Group Header (Colored Card Top) -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 20,20,0,0"
                            HeightRequest="50"
                            Margin="0,15,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{Binding Name, Converter={StaticResource CategoryToColor}}" Offset="0.0" />
                                <GradientStop Color="{Binding Name, Converter={StaticResource CategoryToColor}}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <Grid Padding="15,0" ColumnDefinitions="auto, *, Auto">
                            <!-- Category Icon -->
                             <Label Grid.Column="0" 
                                   Text="{Binding Name, Converter={StaticResource CategoryToIcon}}" 
                                   FontSize="20"
                                   VerticalOptions="Center" 
                                   Margin="0,0,10,0"/>

                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   TextColor="White"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                            
                            <!-- Arrow -->
                            <Label Grid.Column="2"
                                   Text="›"
                                   TextColor="White"
                                   FontSize="24"
                                   VerticalOptions="Center"
                                   FontAttributes="Bold"
                                   Opacity="0.8"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            
            <!-- Group Footer (White Card Bottom Cap) -->
            <!-- Removing Visual Gap by ensuring it connects -->
            <CollectionView.GroupFooterTemplate>
                 <DataTemplate>
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 0,0,20,20"
                            BackgroundColor="White"
                            HeightRequest="20"
                            Margin="0,0,0,0" /> 
                </DataTemplate>
            </CollectionView.GroupFooterTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                             <SwipeItems>
                                <SwipeItem Text="{x:Static strings:AppResources.Edit}"
                                           BackgroundColor="#F59E0B"
                                           Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditItemCommand}"
                                           CommandParameter="{Binding .}"/>
                                <SwipeItem Text="{x:Static strings:AppResources.Delete}"
                                           BackgroundColor="#EF4444"
                                           Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteItemCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        
                        <!-- Item Row (White Background) -->
                        <Grid Padding="15,12" BackgroundColor="White" ColumnDefinitions="Auto, *, Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePurchasedCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                            
                            <!-- Icon Box -->
                            <Border Grid.Column="0"
                                    HeightRequest="36" WidthRequest="36"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{Binding Category, Converter={StaticResource CategoryToColor}, ConverterParameter='0.1'}"
                                    StrokeThickness="0"
                                    Margin="0,0,12,0"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Category, Converter={StaticResource CategoryToIcon}}"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <!-- Name + Quantity -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label TextColor="#1F2937" FontSize="15" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Name}" />
                                            <Span Text="  " />
                                            <Span Text="{Binding Quantity}" TextColor="#6B7280" FontSize="13" />
                                            <Span Text="{Binding Unit}" TextColor="#6B7280" FontSize="11" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPurchased}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter Property="TextColor" Value="#9CA3AF"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                            
                            <!-- Checkbox -->
                             <CheckBox Grid.Column="2" 
                                      IsChecked="{Binding IsPurchased}" 
                                      Color="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CurrentList.Color}"
                                      IsEnabled="False" 
                                      VerticalOptions="Center"/>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
             <CollectionView.Footer>
                 <BoxView HeightRequest="100" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Floating Action Buttons -->
        <!-- Siri / Gradient Style -->
        <VerticalStackLayout Grid.Row="2" 
                             VerticalOptions="End" 
                             HorizontalOptions="End" 
                             Spacing="15" 
                             Margin="20,20,20,40">
            
            <!-- Scan Button -->
            <Border StrokeShape="RoundRectangle 30"
                    StrokeThickness="0"
                    HeightRequest="60"
                    WidthRequest="60"
                    BackgroundColor="Transparent">
                <Border.Shadow>
                    <Shadow Brush="#6D28D9" Offset="0,4" Radius="10" Opacity="0.4"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ScanCommand}" />
                </Border.GestureRecognizers>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A78BFA" Offset="0.0" />
                        <GradientStop Color="#7C3AED" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Image Source="camera_white.png" HeightRequest="28" WidthRequest="28" HorizontalOptions="Center" VerticalOptions="Center">
                     <Image.Source>
                         <FontImageSource Glyph="📷" Color="White" Size="28" />
                     </Image.Source>
                </Image>
            </Border>

            <!-- Voice Button (Larger & Glowing) -->
            <Border StrokeShape="RoundRectangle 35"
                    StrokeThickness="0"
                    HeightRequest="70"
                    WidthRequest="70"
                    BackgroundColor="Transparent">
                <Border.Shadow>
                    <Shadow Brush="#2563EB" Offset="0,8" Radius="15" Opacity="0.5"/>
                </Border.Shadow>
                 <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding StartListeningCommand}" />
                </Border.GestureRecognizers>
                <Border.Background>
                    <!-- Siri-like Gradient -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#06B6D4" Offset="0.0" />
                        <GradientStop Color="#3B82F6" Offset="0.5" />
                        <GradientStop Color="#8B5CF6" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                
                <Image x:Name="MicIcon" Source="mic_white.png" HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" VerticalOptions="Center">
                     <Image.Source>
                         <FontImageSource Glyph="🎤" Color="White" Size="32" />
                     </Image.Source>
                     <Image.Triggers>
                        <DataTrigger TargetType="Image" Binding="{Binding IsListening}" Value="True">
                             <!-- Example feedback -->
                             <Setter Property="Opacity" Value="0.8"/> 
                        </DataTrigger>
                     </Image.Triggers>
                </Image>
            </Border>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
