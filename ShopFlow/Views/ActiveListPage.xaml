<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             x:Class="BrenoMachado.ShopFlow.Views.ActiveListPage"
             x:Name="ThisPage"
             Title="{Binding Title}"
             BackgroundColor="#F9FAFB">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sort" Command="{Binding SortCommand}" Order="Primary" />
        <ToolbarItem Text="Read List" Command="{Binding ReadListCommand}" Order="Secondary" />
        <ToolbarItem Text="{Binding IsShoppingMode, Converter={StaticResource ShoppingModeTextConverter}}" 
                     Command="{Binding ToggleShoppingModeCommand}" />
        <ToolbarItem Text="Share" Command="{Binding ShareCommand}" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *">
        <!-- Shopping Mode Status -->
        <Frame Grid.Row="0" BackgroundColor="#DCFCE7" Padding="10" IsVisible="{Binding IsShoppingMode}" Margin="10,5">
            <Label Text="🛒 Shopping Mode Active (Screen On)" TextColor="#166534" HorizontalOptions="Center" FontAttributes="Bold"/>
        </Frame>

        <!-- Suggestions (Hide in Shopping Mode) -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Suggestions}"
                        HeightRequest="50"
                        Margin="10,5"
                        SelectionMode="None"
                        IsVisible="{Binding IsShoppingMode, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12,6" BackgroundColor="#DBEAFE" CornerRadius="20" BorderColor="Transparent" HasShadow="False">
                        <Label Text="{Binding .}" TextColor="#1E40AF" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.AddSuggestionCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Triggers>
                <DataTrigger TargetType="CollectionView" Binding="{Binding Suggestions.Count}" Value="0">
                    <Setter Property="IsVisible" Value="False"/>
                    <Setter Property="HeightRequest" Value="0"/>
                </DataTrigger>
            </CollectionView.Triggers>
        </CollectionView>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        IsGrouped="True"
                        Margin="0,0,0,80">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}"
                           BackgroundColor="#F3F4F6"
                           TextColor="#111827"
                           FontSize="18"
                           FontAttributes="Bold"
                           Padding="15,10"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.Triggers>
                            <DataTrigger TargetType="SwipeView" Binding="{Binding Source={x:Reference ThisPage}, Path=BindingContext.IsShoppingMode}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </SwipeView.Triggers>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Edit"
                                           BackgroundColor="#F59E0B"
                                           Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditItemCommand}"
                                           CommandParameter="{Binding .}"/>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="#EF4444"
                                           Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteItemCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        
                        <Grid Padding="15" BackgroundColor="White">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePurchasedCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <CheckBox IsChecked="{Binding IsPurchased}" 
                                      VerticalOptions="Center"
                                      IsEnabled="False" 
                                      Color="#2563EB"/>
                                      
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0,0,0">
                                <Label Text="{Binding Name}" 
                                       FontSize="16"
                                       TextColor="#1F2937">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPurchased}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter Property="TextColor" Value="#9CA3AF"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Price, StringFormat='${0:F2}'}" 
                                       FontSize="12" 
                                       TextColor="#059669"
                                       IsVisible="{Binding Price, Converter={StaticResource IsNotNullConverter}}"/>
                            </VerticalStackLayout>
                            
                             <!-- Quantity Badge (Quick Tune) -->
                            <Border Grid.Column="2" 
                                    StrokeShape="RoundRectangle 15" 
                                    BackgroundColor="#EFF6FF" 
                                    Stroke="#BFDBFE"
                                    StrokeThickness="1"
                                    Padding="10,5" 
                                    VerticalOptions="Center" 
                                    Margin="5,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenQuickTuneCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="{Binding Quantity}" TextColor="#2563EB" FontSize="14" FontAttributes="Bold"/>
                                    <Label Text="{Binding Unit}" TextColor="#2563EB" FontSize="12" VerticalTextAlignment="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
                Text="🎤"
                Command="{Binding ListenCommand}"
                BackgroundColor="#059669"
                TextColor="White"
                CornerRadius="30"
                HeightRequest="60"
                WidthRequest="60"
                FontSize="24"
                Margin="20,20,20,90"
                HorizontalOptions="End"
                VerticalOptions="End"
                ZIndex="100"
                Shadow="{Shadow Brush=Black, Offset='0,5', Radius=5, Opacity=0.3}"/>

        <Button Grid.Row="1"
                Text="📷"
                Command="{Binding ScanCommand}"
                BackgroundColor="#7C3AED"
                TextColor="White"
                CornerRadius="30"
                HeightRequest="60"
                WidthRequest="60"
                FontSize="24"
                Margin="20,20,20,160"
                HorizontalOptions="End"
                VerticalOptions="End"
                ZIndex="100"
                Shadow="{Shadow Brush=Black, Offset='0,5', Radius=5, Opacity=0.3}"/>
                
        <Button Grid.Row="1"
                Text="+"
                Command="{Binding AddItemCommand}"
                BackgroundColor="#2563EB"
                TextColor="White"
                CornerRadius="30"
                HeightRequest="60"
                WidthRequest="60"
                FontSize="30"
                Margin="20"
                HorizontalOptions="End"
                VerticalOptions="End"
                ZIndex="100"
                Shadow="{Shadow Brush=Black, Offset='0,5', Radius=5, Opacity=0.3}"/>
    </Grid>
</ContentPage>
