<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             xmlns:strings="clr-namespace:BrenoMachado.ShopFlow.Resources.Strings"
             x:Class="BrenoMachado.ShopFlow.Views.DashboardPage"
             x:Name="ThisPage"
             Title="{Binding Title}"
             BackgroundColor="#F9FAFB">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙️" Command="{Binding GoToSettingsCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto">
        <CollectionView Grid.Row="0" 
                        ItemsSource="{Binding Lists}"
                        SelectionMode="None"
                        Margin="10">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="{x:Static strings:AppResources.Edit}"
                                           BackgroundColor="#F59E0B"
                                           Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditListCommand}"
                                           CommandParameter="{Binding .}"/>
                                <SwipeItem Text="{x:Static strings:AppResources.Delete}"
                                           BackgroundColor="#EF4444"
                                           Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteListCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Frame CornerRadius="10" HasShadow="True" BorderColor="Transparent" Padding="0">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenListCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid Padding="15" BackgroundColor="{Binding PrimaryColor}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Title -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Name}" 
                                       FontSize="20" 
                                       TextColor="White" 
                                       FontAttributes="Bold"/>

                                <!-- Default Star / Icon -->
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding IsDefault, Converter={StaticResource BoolToStarConverter}}"
                                       TextColor="#F59E0B"
                                       FontSize="24"/>

                                <!-- Stats -->
                                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,15,0,15">
                                    <Label Text="{Binding TotalItemsCount, StringFormat='{0} items'}"
                                           TextColor="White"
                                           FontSize="12"
                                           Opacity="0.9"/>
                                    <Label Text="{Binding BoughtItemsCount, StringFormat='{0} items'}"
                                           TextColor="White"
                                           FontSize="12"
                                           Opacity="0.7"/>
                                </VerticalStackLayout>

                                <!-- Progress Bar -->
                                <ProgressBar Grid.Row="2" Grid.ColumnSpan="2"
                                             Progress="{Binding Progress}"
                                             ProgressColor="White"
                                             BackgroundColor="#33FFFFFF"
                                             HeightRequest="6"/>
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
                Text="+"
                Command="{Binding AddListCommand}"
                BackgroundColor="#2563EB"
                TextColor="White"
                CornerRadius="30"
                HeightRequest="60"
                WidthRequest="60"
                FontSize="30"
                Margin="20"
                HorizontalOptions="End"
                VerticalOptions="End"
                Shadow="{Shadow Brush=Black, Offset='0,5', Radius=5, Opacity=0.2}"/>
    </Grid>
</ContentPage>
