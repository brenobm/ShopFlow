<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             xmlns:strings="clr-namespace:BrenoMachado.ShopFlow.Resources.Strings"
             xmlns:converters="clr-namespace:BrenoMachado.ShopFlow.Converters"
             x:Class="BrenoMachado.ShopFlow.Views.ItemDetailPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#f3f4f6">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CategoryToColorConverter x:Key="CategoryToColor" />
            <converters:CategoryToIconConverter x:Key="CategoryToIcon" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Header Gradient -->
        <Grid Grid.Row="0" HeightRequest="120">
            <GraphicsView>
                <GraphicsView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8B5CF6" Offset="0.0" /> <!-- Violet -->
                        <GradientStop Color="#2DD4BF" Offset="1.0" /> <!-- Teal -->
                    </LinearGradientBrush>
                </GraphicsView.Background>
            </GraphicsView>
            
            <Label Text="Add New Item"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="32"
                   Margin="25,50,0,0"/>

             <Label Text="+"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="80"
                    Opacity="0.3"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,-10,20,0"/>

             <!-- Close Button -->
             <ImageButton Source="{FontImage Glyph='✕', Color='White', Size=20}"
                          Command="{Binding CancelCommand}"
                          BackgroundColor="Transparent"
                          HorizontalOptions="End"
                          VerticalOptions="Start"
                          Margin="0,40,20,0"
                          HeightRequest="40" WidthRequest="40">
            </ImageButton>
        </Grid>

        <!-- Body -->
        <ScrollView Grid.Row="1" Padding="20,10,20,20">
            <VerticalStackLayout Spacing="20">
                
                <!-- Input Card -->
                <Border StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        BackgroundColor="White">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="0" Padding="0">
                        <!-- Name Row -->
                        <Grid Padding="15" ColumnDefinitions="40, *, Auto">
                            <Label Text="🍌" FontSize="20" VerticalOptions="Center"/>
                            <Entry Grid.Column="1" 
                                   Text="{Binding Name}"
                                   Placeholder="Item Name (e.g., Bananas)" 
                                   FontSize="16"
                                   TextColor="#1F2937"
                                   PlaceholderColor="#9CA3AF"
                                   Margin="10,0"/>
                            <Label Grid.Column="2" Text="🎤" FontSize="20" TextColor="#2563EB" VerticalOptions="Center"/>
                        </Grid>
                        
                        <BoxView HeightRequest="1" Color="#F3F4F6" Margin="15,0"/>

                        <!-- Price Row -->
                        <Grid Padding="15" ColumnDefinitions="40, *">
                            <Label Text="💰" FontSize="20" VerticalOptions="Center"/>
                            <Entry Grid.Column="1" 
                                   Text="{Binding Price}"
                                   Placeholder="0.00" 
                                   Keyboard="Numeric"
                                   FontSize="16"
                                   TextColor="#1F2937"
                                   PlaceholderColor="#9CA3AF"
                                   Margin="10,0"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Category Section -->
                <Label Text="Category" FontAttributes="Bold" FontSize="18" TextColor="#111827"/>
                
                <CollectionView ItemsSource="{Binding Categories}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedCategory}"
                                HeightRequest="240"> <!-- Fixed height for grid rows roughly -->
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 15"
                                    HeightRequest="70"
                                    StrokeThickness="0">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="Stroke" Value="Black" />
                                                <Setter Property="StrokeThickness" Value="3" />
                                                <Setter Property="Scale" Value="0.95" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{Binding ., Converter={StaticResource CategoryToColor}}" Offset="0.1" />
                                        <GradientStop Color="{Binding ., Converter={StaticResource CategoryToColor}, ConverterParameter='0.8'}" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                
                                <Grid>
                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                        <Label Text="{Binding ., Converter={StaticResource CategoryToIcon}}" 
                                               FontSize="24" HorizontalOptions="Center"/>
                                        <Label Text="{Binding .}" 
                                               TextColor="White" 
                                               FontAttributes="Bold" 
                                               FontSize="12"
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer Actions -->
        <VerticalStackLayout Grid.Row="2" Spacing="15" Padding="20,0,20,30">
            <Button Text="Save Item"
                    Command="{Binding SaveCommand}"
                    FontAttributes="Bold"
                    FontSize="18"
                    TextColor="White"
                    CornerRadius="14"
                    HeightRequest="55">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#8B5CF6" Offset="0.0" />
                        <GradientStop Color="#3B82F6" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Shadow>
                     <Shadow Brush="#8B5CF6" Offset="0,4" Radius="8" Opacity="0.4" />
                </Button.Shadow>
            </Button>

            <Button Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#9CA3AF"
                    FontSize="16"
                    HeightRequest="40"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
