<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             x:Class="BrenoMachado.ShopFlow.Views.ReportsPage"
             Title="{Binding Title}"
             BackgroundColor="#F9FAFB">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">
        <!-- Weekly Summary Card -->
        <Frame BackgroundColor="White" Padding="20" CornerRadius="10" BorderColor="Transparent" HasShadow="True">
            <StackLayout>
                <Label Text="Weekly Activity" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                <Label Text="{Binding WeeklySummary}" FontSize="16" TextColor="#4B5563" Margin="0,5,0,0"/>
            </StackLayout>
        </Frame>

        <!-- Top Items List -->
        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <Label Text="Top Purchased Items" FontSize="18" FontAttributes="Bold" TextColor="#111827"/>
            
            <CollectionView ItemsSource="{Binding TopItems}" HeightRequest="400">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="15" BackgroundColor="White" CornerRadius="8" BorderColor="Transparent" HasShadow="False">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding Name}" FontSize="16" TextColor="#374151" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding Count, StringFormat='Bought {0} times'}" FontSize="14" TextColor="#6B7280" VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No purchase history yet." HorizontalOptions="Center" TextColor="#9CA3AF" Margin="0,20"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
