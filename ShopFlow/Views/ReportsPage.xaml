<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             x:Class="BrenoMachado.ShopFlow.Views.ReportsPage"
             Title="{Binding Title}"
             BackgroundColor="#F9FAFB">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            
            <!-- Segment / Header -->
            <Label Text="Your Spending Habits" FontSize="20" FontAttributes="Bold" TextColor="#111827"/>

            <!-- Top Items Section -->
            <Frame BackgroundColor="White" CornerRadius="12" HasShadow="True" BorderColor="Transparent" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Top 5 Most Purchased" FontSize="16" FontAttributes="Bold" TextColor="#4B5563"/>
                    
                    <CollectionView ItemsSource="{Binding TopItems}" HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Label Text="{Binding Label}" TextColor="#374151" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                    
                                    <!-- Custom Bar -->
                                    <BoxView Grid.Column="1" 
                                             Color="#3B82F6" 
                                             HeightRequest="20" 
                                             HorizontalOptions="Start" 
                                             WidthRequest="{Binding BarWidth}" 
                                             CornerRadius="4"
                                             VerticalOptions="Center"/>
                                             
                                    <Label Grid.Column="2" Text="{Binding ValueLabel}" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" HorizontalOptions="End"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Category Breakdown Section -->
            <Frame BackgroundColor="White" CornerRadius="12" HasShadow="True" BorderColor="Transparent" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Category Breakdown" FontSize="16" FontAttributes="Bold" TextColor="#4B5563"/>

                    <CollectionView ItemsSource="{Binding CategoryDistribution}" HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Text="{Binding Label}" TextColor="#374151" VerticalOptions="Center" LineBreakMode="TailTruncation"/>

                                    <BoxView Grid.Column="1" 
                                             Color="#10B981" 
                                             HeightRequest="20" 
                                             HorizontalOptions="Start" 
                                             WidthRequest="{Binding BarWidth}" 
                                             CornerRadius="4"
                                             VerticalOptions="Center"/>

                                    <Label Grid.Column="2" Text="{Binding ValueLabel}" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" HorizontalOptions="End"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>
            
             <!-- Purchase Log Section -->
            <Label Text="Purchase History" FontSize="20" FontAttributes="Bold" TextColor="#111827" Margin="0,10,0,0"/>
             
             <CollectionView ItemsSource="{Binding History}" HeightRequest="300">
                 <CollectionView.ItemTemplate>
                     <DataTemplate>
                         <Grid Padding="10" ColumnDefinitions="*, Auto">
                             <Label Text="{Binding ItemName}" TextColor="#1F2937" FontAttributes="Bold"/>
                             <Label Grid.Column="1" Text="{Binding DatePurchased, StringFormat='{0:MMM dd}'}" TextColor="#6B7280" FontSize="12"/>
                         </Grid>
                     </DataTemplate>
                 </CollectionView.ItemTemplate>
             </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
