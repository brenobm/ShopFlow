<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BrenoMachado.ShopFlow.Views.LoadingPage"
             BackgroundColor="White">
    <Grid>
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
            <ActivityIndicator IsRunning="True" Color="#2563EB" HeightRequest="50" WidthRequest="50"/>
            <Label Text="Verifying session..." TextColor="#6B7280" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
