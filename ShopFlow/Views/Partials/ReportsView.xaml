<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             xmlns:strings="clr-namespace:BrenoMachado.ShopFlow.Resources.Strings"
             x:Class="BrenoMachado.ShopFlow.Views.Partials.ReportsView"
             BackgroundColor="#F9FAFB">
    
    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">
        <!-- New Floating Card Style for Weekly Summary -->
        <Frame BackgroundColor="White" 
               Padding="20" 
               CornerRadius="15" 
               BorderColor="Transparent" 
               HasShadow="True">
             <Frame.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05" />
            </Frame.Shadow>
            <StackLayout Spacing="5">
                <Label Text="{x:Static strings:AppResources.WeeklySummary}" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="#111827" />
                <Label Text="{Binding WeeklySummary}" 
                       FontSize="16" 
                       TextColor="#6B7280" />
            </StackLayout>
        </Frame>

        <!-- Top Items with "Popular" styling -->
        <VerticalStackLayout Grid.Row="1" Spacing="15">
            <Label Text="{x:Static strings:AppResources.TopItems}" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="#111827"/>
            
            <CollectionView ItemsSource="{Binding TopItems}" HeightRequest="400">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="15" 
                               BackgroundColor="White" 
                               CornerRadius="12" 
                               BorderColor="Transparent" 
                               HasShadow="False">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding Name}" 
                                       FontSize="16" 
                                       TextColor="#374151" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1" 
                                       Text="{Binding Count, StringFormat='{x:Static strings:AppResources.BoughtTimes}'}" 
                                       FontSize="14" 
                                       TextColor="#9CA3AF" 
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                     <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,40">
                        <Label Text="📊" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="{x:Static strings:AppResources.NoHistory}" 
                               HorizontalOptions="Center" 
                               TextColor="#9CA3AF" />
                     </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="100" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentView>
