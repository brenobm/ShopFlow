<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             xmlns:strings="clr-namespace:BrenoMachado.ShopFlow.Resources.Strings"
             x:Class="BrenoMachado.ShopFlow.Views.Partials.DashboardView"
             x:Name="ThisView">
    <!-- Global Gradient Background -->
    <ContentView.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7C3AED" Offset="0.0" /> <!-- Purple -->
            <GradientStop Color="#2563EB" Offset="1.0" /> <!-- Blue -->
        </LinearGradientBrush>
    </ContentView.Background>

    <Grid RowDefinitions="100, *" BackgroundColor="Transparent"> 
        <!-- Row 0: Header (Transparent) -->
        <Grid Grid.Row="0" Padding="20,10,20,0" ColumnDefinitions="*, Auto">
            <!-- Title -->
            <Label Grid.Column="0" 
                   Text="Shopping Lists" 
                   TextColor="White" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" />

            <!-- Add Button (Just Text, Top Right) -->
            <Label Grid.Column="1"
                   Text="+" 
                   TextColor="White" 
                   FontSize="40" 
                   FontAttributes="None"
                   VerticalOptions="Start"
                   HorizontalOptions="End"
                   Margin="0,10,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddListCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Row 1: Content (White/Gray with Top Rounded Corners) -->
        <!-- Changed BackgroundColor to Transparent to remove gray area if items don't fill it, or White if it needs to be a solid card -->
        <Border Grid.Row="1" 
                BackgroundColor="White" 
                StrokeThickness="0"
                StrokeShape="RoundRectangle 30,30,0,0"
                Margin="0,0,0,0"> 
            <!-- Added Padding bottom to handle safe area if needed -->   
            <CollectionView ItemsSource="{Binding Lists}"
                            SelectionMode="None"
                            BackgroundColor="Transparent"
                            Margin="0,20,0,0"> 
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" 
                                     Span="1" 
                                     VerticalItemSpacing="16" 
                                     HorizontalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView Threshold="200">
                             <!-- Swipe Left (Reveals Right Side Actions) -->
                             <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItemView Command="{Binding Source={x:Reference ThisView}, Path=BindingContext.EditListCommand}"
                                                   CommandParameter="{Binding .}">
                                        <Border HeightRequest="130"
                                                WidthRequest="90"
                                                StrokeShape="RoundRectangle 20"
                                                StrokeThickness="0"
                                                BackgroundColor="#3B82F6"
                                                Margin="16,0,4,0">
                                            <Label Text="{x:Static strings:AppResources.Edit}"
                                                   TextColor="White" 
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </SwipeItemView>

                                    <SwipeItemView Command="{Binding Source={x:Reference ThisView}, Path=BindingContext.DeleteListCommand}"
                                                   CommandParameter="{Binding .}">
                                        <Border HeightRequest="130"
                                                WidthRequest="90"
                                                StrokeShape="RoundRectangle 20"
                                                StrokeThickness="0"
                                                BackgroundColor="#EF4444"
                                                Margin="4,0,16,0">
                                            <Label Text="{x:Static strings:AppResources.Delete}"
                                                   TextColor="White" 
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            
                            <Border HeightRequest="130"
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="0"
                                    Margin="16,0">
                                
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.1" />
                                </Border.Shadow>
                                
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{Binding PrimaryColor}" Offset="0.0" />
                                        <GradientStop Color="{Binding SecondaryColor}" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=OpenListCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
        
                                <Grid Padding="16" RowDefinitions="Auto,*,Auto">
                                    <!-- Top: Title and Icons -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto">
                                        <!-- Title -->
                                        <Label Grid.Column="0"
                                               Text="{Binding Name}"
                                               TextColor="White"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />

                                        <!-- Default Star Indicator -->
                                        <Label Grid.Column="1"
                                               Text="★"
                                               FontSize="20"
                                               TextColor="Yellow"
                                               Margin="0,0,8,0"
                                               IsVisible="{Binding IsDefault}" />
                                        
                                        <!-- Icon - RESTORED BINDING -->
                                        <Label Grid.Column="2"
                                               Text="{Binding Icon}" 
                                               FontSize="24"
                                               TextColor="White"
                                               Opacity="0.9" />
                                    </Grid>
                                    
                                    <!-- Middle: Stats -->
                                    <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding TotalItemsCount, StringFormat='{0} items'}"
                                               TextColor="White"
                                               FontSize="14"
                                               Opacity="0.9" />
                                        <Label Text="{Binding BoughtItemsCount, StringFormat='{0} items'}"
                                               TextColor="White"
                                               FontSize="12"
                                               Opacity="0.7" />
                                    </VerticalStackLayout>
        
                                    <!-- Bottom: Progress Bar -->
                                     <Grid Grid.Row="2" VerticalOptions="End" Margin="0,10,0,0">
                                        <ProgressBar Progress="{Binding Progress}" 
                                                     ProgressColor="White" 
                                                     ScaleY="2.0"
                                                     BackgroundColor="#4CFFFFFF" /> 
                                    </Grid>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
                <CollectionView.Footer>
                     <!-- Reduced height to avoid massive gray space if not needed -->
                     <BoxView HeightRequest="20" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </Border>
    </Grid>
</ContentView>
