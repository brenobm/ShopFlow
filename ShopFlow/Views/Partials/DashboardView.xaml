<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             xmlns:strings="clr-namespace:BrenoMachado.ShopFlow.Resources.Strings"
             x:Class="BrenoMachado.ShopFlow.Views.Partials.DashboardView"
             BackgroundColor="#F9FAFB">
    
    <!-- Modern Dashboard Grid -->
    <Grid RowDefinitions="120, *" BackgroundColor="#F0F2F5"> 
        <!-- Row 0: Rounded Header -->
        <Border Grid.Row="0" 
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,30,30"
                Margin="0,0,0,0">
             <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7C3AED" Offset="0.0" /> <!-- Purple -->
                    <GradientStop Color="#2563EB" Offset="1.0" /> <!-- Blue -->
                </LinearGradientBrush>
            </Border.Background>
            
            <Grid Padding="20,10,20,0" ColumnDefinitions="*, Auto">
                <!-- Title -->
                <Label Grid.Column="0" 
                       Text="Shopping Lists" 
                       TextColor="White" 
                       FontSize="28" 
                       FontAttributes="Bold" 
                       VerticalOptions="Center" />

                <!-- Add Button (Plus) -->
                <Border Grid.Column="1"
                        HeightRequest="40"
                        WidthRequest="40"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1"
                        Stroke="White"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddListCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="+" 
                           TextColor="White" 
                           FontSize="24" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           Margin="0,-2,0,0"/>
                </Border>
            </Grid>
        </Border>

        <!-- Row 1: Content -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Lists}"
                        SelectionMode="None"
                        BackgroundColor="Transparent"
                        Margin="0,20,0,0"> <!-- Top margin to separate from rounded header -->
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" 
                                 Span="1" 
                                 VerticalItemSpacing="16" 
                                 HorizontalItemSpacing="16" />
            </CollectionView.ItemsLayout>
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border HeightRequest="130"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="0"
                            Margin="16,0"> <!-- Horizontal margin for side padding -->
                        
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.1" />
                        </Border.Shadow>
                        
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{Binding PrimaryColor}" Offset="0.0" />
                                <GradientStop Color="{Binding SecondaryColor}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=OpenListCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid Padding="16" RowDefinitions="Auto,*,Auto">
                            <!-- Top: Title and Icon -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding Name}"
                                       TextColor="White"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                
                                <!-- Icon Placeholder -->
                                <Label Grid.Column="1"
                                       Text="🛒" 
                                       FontSize="24"
                                       TextColor="White"
                                       Opacity="0.8" />
                            </Grid>
                            
                            <!-- Middle: Stats -->
                            <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding TotalItemsCount, StringFormat='{0} items'}"
                                       TextColor="White"
                                       FontSize="14"
                                       Opacity="0.9" />
                                <Label Text="{Binding BoughtItemsCount, StringFormat='{0} items'}"
                                       TextColor="White"
                                       FontSize="12"
                                       Opacity="0.7" />
                            </VerticalStackLayout>

                            <!-- Bottom: Progress Bar -->
                             <!-- Bottom: Progress Bar -->
                             <Grid Grid.Row="2" VerticalOptions="End" Margin="0,10,0,0">
                                <ProgressBar Progress="{Binding Progress}" 
                                             ProgressColor="White" 
                                             ScaleY="2.0"
                                             BackgroundColor="#4CFFFFFF" /> <!-- 30% White -->
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
            <CollectionView.Footer>
                 <BoxView HeightRequest="100" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
     </Grid>
     </Grid>
</ContentView>
