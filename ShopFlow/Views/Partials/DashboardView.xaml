<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             xmlns:strings="clr-namespace:BrenoMachado.ShopFlow.Resources.Strings"
             x:Class="BrenoMachado.ShopFlow.Views.Partials.DashboardView"
             BackgroundColor="#F9FAFB">
    
    <!-- Migrated Grid from DashboardPage -->
    <Grid RowDefinitions="*, Auto">
         <CollectionView Grid.Row="0" 
                        ItemsSource="{Binding Lists}"
                        SelectionMode="None"
                        Margin="10">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView> <!-- ... (SwipeView content same as original) ... -->
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="{x:Static strings:AppResources.Edit}"
                                           BackgroundColor="#F59E0B"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=EditListCommand}"
                                           CommandParameter="{Binding .}"/>
                                <SwipeItem Text="{x:Static strings:AppResources.Delete}"
                                           BackgroundColor="#EF4444"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=DeleteListCommand}"
                                           CommandParameter="{Binding .}"/>
                                <SwipeItem Text="{x:Static strings:AppResources.Share}"
                                           BackgroundColor="#3B82F6"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=ShareListCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Frame CornerRadius="10" HasShadow="True" BorderColor="Transparent" Padding="0">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=OpenListCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid Padding="15" BackgroundColor="White" ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" 
                                       Text="{Binding Name}" 
                                       FontSize="18" 
                                       TextColor="#1F2937" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                                
                                <Button Grid.Column="1"
                                        Text="★"
                                        TextColor="#9CA3AF"
                                        BackgroundColor="Transparent"
                                        FontSize="24"
                                        Padding="0"
                                        HeightRequest="40"
                                        WidthRequest="40"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=SetDefaultListCommand}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsDefault}" Value="True">
                                            <Setter Property="TextColor" Value="#F59E0B" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="100" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <Button Grid.Row="1"
                Text="+"
                Command="{Binding AddListCommand}"
                BackgroundColor="#2563EB"
                TextColor="White"
                CornerRadius="30"
                HeightRequest="60"
                WidthRequest="60"
                FontSize="30"
                Margin="20,20,20,80" 
                HorizontalOptions="End"
                VerticalOptions="End"
                Shadow="{Shadow Brush=Black, Offset='0,5', Radius=5, Opacity=0.2}"/>
                <!-- Adjusted Margin Bottom to account for Floating Pill -->
    </Grid>
</ContentView>
