<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             x:Class="BrenoMachado.ShopFlow.Views.ListFormPage"
             x:Name="ThisPage"
             Title="{Binding Title, FallbackValue='New List'}"
             BackgroundColor="White">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="25">
            
            <!-- Icon & Name Row -->
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                <!-- Icon Picker -->
                <Border StrokeShape="RoundRectangle 20"
                        HeightRequest="80" WidthRequest="80"
                        BackgroundColor="#F3F4F6"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickIconCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding SelectedIcon}"
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <!-- Name Entry -->
                <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                    <Label Text="List Name" TextColor="#6B7280" FontSize="12" FontAttributes="Bold"/>
                    <Entry Text="{Binding Name}"
                           Placeholder="E.g., Weekly Groceries"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#111827"
                           BackgroundColor="Transparent"/>
                    <BoxView HeightRequest="1" Color="#E5E7EB"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Default Toggle -->
            <Grid ColumnDefinitions="*, Auto" BackgroundColor="#F9FAFB" Padding="15" Margin="0,10">
                <Grid.Resources>
                    <Style TargetType="Border">
                        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
                        <Setter Property="StrokeThickness" Value="0"/>
                    </Style>
                </Grid.Resources>
                
                <VerticalStackLayout Spacing="2">
                    <Label Text="Set as Default List" TextColor="#1F2937" FontAttributes="Bold" FontSize="16"/>
                    <Label Text="New items added via Siri/Shortcuts will go here." TextColor="#6B7280" FontSize="12"/>
                </VerticalStackLayout>
                
                <Switch Grid.Column="1" IsToggled="{Binding IsDefault}" OnColor="#FBBF24" ThumbColor="White"/>
            </Grid>

            <!-- Color Picker -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Theme Color" TextColor="#6B7280" FontSize="12" FontAttributes="Bold"/>
                
                <CollectionView ItemsSource="{Binding AvailableColors}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedColor}"
                                SelectionChangedCommand="{Binding PickColorCommand}"
                                SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}"
                                HeightRequest="60">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 25"
                                    HeightRequest="50" WidthRequest="50"
                                    BackgroundColor="{Binding .}"
                                    StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.PickColorCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <!-- Checkmark overlay if selected could be added here with complex trigger, 
                                     but for now simple feedback relies on header color change or external binding -->
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="Stroke" Value="#111827" />
                                                    <Setter Property="StrokeThickness" Value="3" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Preview Card -->
            <VerticalStackLayout Spacing="10" Margin="0,20,0,0">
                <Label Text="Preview" TextColor="#6B7280" FontSize="12" FontAttributes="Bold"/>
                
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 15"
                        HeightRequest="100"
                        BackgroundColor="White"
                        Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.1}">
                    <Grid ColumnDefinitions="15, *" Padding="0">
                        <!-- Color Strip -->
                        <BoxView Grid.Column="0" Color="{Binding SelectedColor}" />
                        
                        <Grid Grid.Column="1" Padding="15" RowDefinitions="Auto, Auto, *">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding SelectedIcon}" FontSize="24" VerticalOptions="Center"/>
                                <Label Text="{Binding Name, TargetNullValue='List Name'}" 
                                       FontSize="20" FontAttributes="Bold" TextColor="#1F2937" VerticalOptions="Center"/>
                                <Label Text="★" TextColor="#FBBF24" FontSize="20" IsVisible="{Binding IsDefault}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            
                            <ProgressBar Grid.Row="1" Progress="0.5" ProgressColor="{Binding SelectedColor}" Margin="0,10,0,0"/>
                            <Label Grid.Row="2" Text="XX items • YY bought" FontSize="12" TextColor="#6B7280" />
                        </Grid>
                    </Grid>
                </Border>
            </VerticalStackLayout>
            
            <!-- Save Button (Bottom) -->
            <Button Text="Save List"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#059669"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,20,0,0">
                 <Button.Shadow>
                    <Shadow Brush="#059669" Offset="0,4" Radius="8" Opacity="0.4" />
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
