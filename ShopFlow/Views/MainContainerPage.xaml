<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             xmlns:partials="clr-namespace:BrenoMachado.ShopFlow.Views.Partials"
             xmlns:strings="clr-namespace:BrenoMachado.ShopFlow.Resources.Strings"
             xmlns:views="clr-namespace:BrenoMachado.ShopFlow.Views"
             x:Class="BrenoMachado.ShopFlow.Views.MainContainerPage"
             x:Name="MainPageRoot"
             BackgroundColor="#f3f4f6"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title, Mode=OneWay}">

    <ContentPage.BindingContext>
        <vm:MainContainerViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <views:BoolToColorConverter x:Key="BoolToColorConverter" />
            <views:BoolToTextColorConverter x:Key="BoolToTextColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid IgnoreSafeArea="True" RowDefinitions="*, 80">
        <!-- Main Content Area -->
        <Grid Grid.Row="0">
            <partials:DashboardView IsVisible="{Binding BindingContext.IsListsViewVisible, Source={x:Reference MainPageRoot}}" />
            <partials:ReportsView IsVisible="{Binding BindingContext.IsReportsViewVisible, Source={x:Reference MainPageRoot}}" />
        </Grid>

        <!-- Bottom Navigation Bar -->
        <Border Grid.Row="1" 
                BackgroundColor="White" 
                StrokeThickness="0"
                Shadow="{Shadow Brush=Black, Offset='0,-2', Radius=10, Opacity=0.1}">
            <Grid ColumnDefinitions="*,*,*,*">
                <!-- Tab 1: Dashboard (Lists) -->
                <Grid Grid.Column="0">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SwitchToListsCommand}" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                        <!-- Icon (List) - Changed from Home PNG to Emoji for Consistency/Request -->
                         <Label Text="📋" FontSize="24" HorizontalOptions="Center" TextColor="#6B7280">
                             <Label.Triggers>
                                 <DataTrigger TargetType="Label" Binding="{Binding IsListsViewVisible}" Value="True">
                                     <Setter Property="TextColor" Value="#7C3AED" /> <!-- Active Purple -->
                                 </DataTrigger>
                             </Label.Triggers>
                         </Label>

                         <!-- Indicator/Label -->
                         <Label Text="{x:Static strings:AppResources.Lists}" 
                                FontSize="10"
                                HorizontalOptions="Center"
                                TextColor="#6B7280">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsListsViewVisible}" Value="True">
                                        <Setter Property="TextColor" Value="#7C3AED" />
                                    </DataTrigger>
                                </Label.Triggers>
                         </Label> 
                    </VerticalStackLayout>
                </Grid>

                <!-- Tab 2: Reports -->
                <Grid Grid.Column="1">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SwitchToReportsCommand}" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                        <Label Text="📊" FontSize="24" HorizontalOptions="Center" TextColor="#6B7280">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsReportsViewVisible}" Value="True">
                                    <Setter Property="TextColor" Value="#2563EB" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{x:Static strings:AppResources.Reports}" 
                               FontSize="10"
                               HorizontalOptions="Center"
                               TextColor="#6B7280">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsReportsViewVisible}" Value="True">
                                    <Setter Property="TextColor" Value="#2563EB" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Grid>

                <!-- Tab 3: Profile (Placeholder) -->
                <Grid Grid.Column="2">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                        <Label Text="👤" FontSize="24" HorizontalOptions="Center" TextColor="#9CA3AF" />
                        <Label Text="Profile" FontSize="10" HorizontalOptions="Center" TextColor="#9CA3AF" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Tab 4: Settings -->
                <Grid Grid.Column="3">
                    <Grid.GestureRecognizers>
                         <!-- Directly Nav to Settings using VM Command if avail, or code behind -->
                         <TapGestureRecognizer Command="{Binding GoToSettingsCommand}" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                        <Label Text="⚙️" FontSize="24" HorizontalOptions="Center" TextColor="#6B7280" />
                        <Label Text="Settings" FontSize="10" HorizontalOptions="Center" TextColor="#6B7280" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>
    </Grid>


</ContentPage>
