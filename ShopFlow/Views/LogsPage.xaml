<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.ShopFlow.ViewModels"
             x:Class="BrenoMachado.ShopFlow.Views.LogsPage"
             Title="{Binding Title}"
             BackgroundColor="#1e1e1e">

    <Grid RowDefinitions="*, Auto" Padding="0" BackgroundColor="#111827">

        <!-- Logs Content -->
        <Border Grid.Row="0" 
                Margin="10" 
                StrokeShape="RoundRectangle 10" 
                StrokeThickness="0" 
                BackgroundColor="#000000">
            <Editor Text="{Binding Logs}" 
                    IsReadOnly="True" 
                    AutoSize="TextChanges" 
                    FontSize="12"
                    TextColor="#10B981"
                    BackgroundColor="Transparent"
                    FontFamily="Monospace" 
                    Margin="10"/>
        </Border>

        <!-- Actions Footer -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10" Padding="15,10,15,30">
            <Button Grid.Column="0"
                    Text="Refresh" 
                    Command="{Binding RefreshCommand}" 
                    BackgroundColor="#374151" 
                    TextColor="White" 
                    CornerRadius="8"
                    HeightRequest="50"/>
            
            <Button Grid.Column="1"
                    Text="Clean" 
                    Command="{Binding ClearCommand}" 
                    BackgroundColor="#DC2626" 
                    TextColor="White" 
                    CornerRadius="8"
                    HeightRequest="50"
                    FontAttributes="Bold"/>
            
            <Button Grid.Column="2"
                    Text="Copy" 
                    Command="{Binding CopyCommand}" 
                    BackgroundColor="#2563EB" 
                    TextColor="White" 
                    CornerRadius="8"
                    HeightRequest="50"/>
        </Grid>
        
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           Color="#10B981" />
    </Grid>
</ContentPage>
