<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.SmartShopping.ViewModels"
             x:Class="BrenoMachado.SmartShopping.Views.ActiveListPage"
             x:Name="ThisPage"
             Title="{Binding Title}"
             BackgroundColor="#F9FAFB">

    <Grid RowDefinitions="Auto, *">
        <!-- Suggestions -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Suggestions}"
                        HeightRequest="50"
                        Margin="10,5"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12,6" BackgroundColor="#DBEAFE" CornerRadius="20" BorderColor="Transparent" HasShadow="False">
                        <Label Text="{Binding .}" TextColor="#1E40AF" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.AddSuggestionCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Triggers>
                <DataTrigger TargetType="CollectionView" Binding="{Binding Suggestions.Count}" Value="0">
                    <Setter Property="IsVisible" Value="False"/>
                    <Setter Property="HeightRequest" Value="0"/>
                </DataTrigger>
            </CollectionView.Triggers>
        </CollectionView>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        IsGrouped="True"
                        Margin="0,0,0,80">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}"
                           BackgroundColor="#F3F4F6"
                           TextColor="#111827"
                           FontSize="18"
                           FontAttributes="Bold"
                           Padding="15,10"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Edit"
                                           BackgroundColor="#F59E0B"
                                           Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditItemCommand}"
                                           CommandParameter="{Binding .}"/>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="#EF4444"
                                           Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteItemCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        
                        <Grid Padding="15" BackgroundColor="White">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePurchasedCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <CheckBox IsChecked="{Binding IsPurchased}" 
                                      VerticalOptions="Center"
                                      IsEnabled="False" 
                                      Color="#2563EB"/>
                                      
                            <Label Grid.Column="1" 
                                   Text="{Binding Name}" 
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   TextColor="#1F2937"
                                   Margin="10,0,0,0">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsPurchased}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="TextColor" Value="#9CA3AF"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
                Text="🎤"
                Command="{Binding ListenCommand}"
                BackgroundColor="#059669"
                TextColor="White"
                CornerRadius="30"
                HeightRequest="60"
                WidthRequest="60"
                FontSize="24"
                Margin="20,20,20,90"
                HorizontalOptions="End"
                VerticalOptions="End"
                Shadow="{Shadow Brush=Black, Offset='0,5', Radius=5, Opacity=0.2}"/>
                
        <Button Grid.Row="1"
                Text="+"
                Command="{Binding AddItemCommand}"
                BackgroundColor="#2563EB"
                TextColor="White"
                CornerRadius="30"
                HeightRequest="60"
                WidthRequest="60"
                FontSize="30"
                Margin="20"
                HorizontalOptions="End"
                VerticalOptions="End"
                Shadow="{Shadow Brush=Black, Offset='0,5', Radius=5, Opacity=0.2}"/>
    </Grid>
</ContentPage>
