<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrenoMachado.SmartShopping.ViewModels"
             x:Class="BrenoMachado.SmartShopping.Views.ActiveListPage"
             x:Name="ThisPage"
             Title="{Binding Title}"
             BackgroundColor="#F9FAFB">

    <Grid RowDefinitions="*, Auto">
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        Margin="0,0,0,80">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Edit"
                                           BackgroundColor="#F59E0B"
                                           Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditItemCommand}"
                                           CommandParameter="{Binding .}"/>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="#EF4444"
                                           Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteItemCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        
                        <Grid Padding="15" BackgroundColor="White">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePurchasedCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <CheckBox IsChecked="{Binding IsPurchased}" 
                                      VerticalOptions="Center"
                                      IsEnabled="False" 
                                      Color="#2563EB"/>
                                      
                            <Label Grid.Column="1" 
                                   Text="{Binding Name}" 
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   TextColor="#1F2937"
                                   Margin="10,0,0,0">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsPurchased}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="TextColor" Value="#9CA3AF"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="0"
                Text="🎤"
                BackgroundColor="#059669"
                TextColor="White"
                CornerRadius="30"
                HeightRequest="60"
                WidthRequest="60"
                FontSize="24"
                Margin="20,20,20,90"
                HorizontalOptions="End"
                VerticalOptions="End"
                Shadow="{Shadow Brush=Black, Offset='0,5', Radius=5, Opacity=0.2}"/>
                
        <Button Grid.Row="0"
                Text="+"
                Command="{Binding AddItemCommand}"
                BackgroundColor="#2563EB"
                TextColor="White"
                CornerRadius="30"
                HeightRequest="60"
                WidthRequest="60"
                FontSize="30"
                Margin="20"
                HorizontalOptions="End"
                VerticalOptions="End"
                Shadow="{Shadow Brush=Black, Offset='0,5', Radius=5, Opacity=0.2}"/>
    </Grid>
</ContentPage>
